# Copy this file to ".env" and edit as needed.
# Django reads these values in config/settings.py

# --- Core Django settings ---
DJANGO_SECRET_KEY=dev-only-secret-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database engine switch ---
# "sqlite" = zero setup, single file database, great for learning/local dev (DEFAULT)
# "postgres" = production-style database, matches the interview guide's architecture
DB_ENGINE=sqlite

# --- Only needed if DB_ENGINE=postgres ---
DB_NAME=ford_platform
DB_USER=app
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
