
import requests
import time

def get_data():
    API_URL="https://jsonplaceholder.typicode.com/posts"
    resp=requests.get(API_URL)
    #print(resp)
    if resp.status_code == 200:
        data=resp.json()
        return data
    else:
        print('Error:',resp.status_code)
